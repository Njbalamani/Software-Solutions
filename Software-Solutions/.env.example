DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

DB_ENGINE=sqlite
# For MySQL set DB_ENGINE=mysql and install mysqlclient.
DB_NAME=balatech
DB_USER=balatech
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Leave as console backend for local development. Use SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
CONTACT_EMAIL=hello@yourdomain.com
